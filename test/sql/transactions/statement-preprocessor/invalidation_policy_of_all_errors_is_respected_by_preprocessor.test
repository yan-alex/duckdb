# name: test/sql/transactions/statement-preprocessor/invalidation_policy_of_all_errors_is_respected_by_preprocessor.test
# group: [statement-preprocessor]

statement ok
ATTACH '__TEST_DIR__/wal_replay.db';

statement ok
USE wal_replay;

statement ok
PRAGMA disable_checkpoint_on_shutdown;

statement ok
SET wal_autocheckpoint='1TB'

statement ok
CREATE OR REPLACE TABLE t AS SELECT range::INT AS id FROM range(10);

statement ok
BEGIN;

statement ok
SET current_transaction_invalidation_policy=ALL_ERRORS_INVALIDATE_TRANSACTION;

statement ok
ALTER TABLE t ADD COLUMN d TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP;

statement ok
SET current_transaction_invalidation_policy=ALL_ERRORS_INVALIDATE_TRANSACTION;

# Invalidates with ALL_ERRORS_INVALIDATE_TRANSACTION but not with STANDARD_POLICY
# Should invalidate in this case, because we SET it earlier.
statement error
SELECT nonexistent_column FROM t;
----
Binder Error: Referenced column "nonexistent_column" not found in FROM clause!

statement ok
commit;

# results in invalid transaction
statement error
from t;
---
Rollback